# API Settings
SECRET_KEY=your-secret-key-here-change-in-production
API_V1_STR=/api/v1
PROJECT_NAME=LangChain Agent API

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/langchain_api

# Redis
REDIS_URL=redis://localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Performance
MAX_CONCURRENT_AGENTS=10000
AGENT_EXECUTION_TIMEOUT=300

# MCP Server Configuration
# Uvicorn (FastAPI) runs on port 8000 by default.
# MCP SSE Server runs on a DIFFERENT port (8190) to avoid conflicts.
MCP_HTTP_URL=
MCP_HTTP_TOKEN=
MCP_HTTP_ALLOWED_TOOLS=[]
MCP_SSE_URL=http://localhost:8190/sse
MCP_SSE_TOKEN=
MCP_SSE_ALLOWED_TOOLS=[]
# Port/host used by: python mcp_server.py --sse
MCP_SSE_PORT=8190
MCP_SSE_HOST=0.0.0.0